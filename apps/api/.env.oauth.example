# OAuth Configuration Example
# Copy this to your .env file and replace with your actual credentials

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-from-console
GOOGLE_CLIENT_SECRET=your-google-client-secret-from-console

# Native Google Sign-In platform clients (SW2-P1)
# Google OAuth client IDs registered for the mobile apps. They form the
# server-side azp allowlist for POST /api/v1/oauth/native/google ID-token
# verification. Production fails closed when both are unset.
# Android: create an "Android" OAuth client for package
#          com.anonymous.gratefulmobile (SHA-1 from the debug keystore and
#          the EAS/release keystore).
# iOS (SW2-P4): create an "iOS" OAuth client for the bundle id.
ANDROID_GOOGLE_CLIENT_ID=your-android-google-client-id-from-console
IOS_GOOGLE_CLIENT_ID=your-ios-google-client-id-from-console

# Apple OAuth Configuration  
APPLE_CLIENT_ID=your-apple-app-id-from-developers
APPLE_CLIENT_SECRET=your-apple-app-secret-from-developers

# OAuth Redirect URI (adjust for your domain)
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# For production, use:
# OAUTH_REDIRECT_URI=https://yourdomain.com/auth/callback